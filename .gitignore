#Ignore Visual Studio temporary files, build results, secrets,
#local databases, and files generated by development tools.
#Based on:
#https://github.com/github/gitignore/blob/main/VisualStudio.gitignore
#User-specific files
*.rsuser *.suo *.user *.userosscache *.sln.docstates *.userprefs

#Mono auto generated files
mono_crash.*

#Environment configuration and secrets
.env .env.* !.env.example

appsettings.Development.json appsettings.Production.json appsettings.*.local.json secrets.json

#Certificates and private keys
*.pfx *.p12 *.key

#Build results
[Dd]ebug/ [Dd]ebugPublic/ [Rr]elease/ [Rr]eleases/

[Dd]ebug/x64/ [Dd]ebugPublic/x64/ [Rr]elease/x64/ [Rr]eleases/x64/ bin/x64/ obj/x64/

[Dd]ebug/x86/ [Dd]ebugPublic/x86/ [Rr]elease/x86/ [Rr]eleases/x86/ bin/x86/ obj/x86/

[Ww][Ii][Nn]32/ [Aa][Rr][Mm]/ [Aa][Rr][Mm]64/ [Aa][Rr][Mm]64[Ee][Cc]/ bld/ [Oo]bj/ [Oo]ut/ [Ll]og/ [Ll]ogs/

*/[Bb]in/

#Visual Studio
.vs/ Generated\ Files/ *.vspscc *.vssscc *.scc

#Visual Studio profiling
*.psess *.vsp *.vspx *.sap *.e2e

#Visual Studio cache
.[Cc]ache !?.[Cc]ache/

#Test results
[Tt]est[Rr]esult*/ [Bb]uild[Ll]og.* *.trx

#NUnit
.VisualState.xml TestResult.xml nunit-.xml

#Code coverage
coverage*.json coverage*.xml coverage*.info *.coverage *.coveragexml .coverage/

#Benchmark results
BenchmarkDotNet.Artifacts/

#.NET / ASP.NET Core
project.lock.json project.fragment.lock.json artifacts/ .artifacts/ ScaffoldingReadMe.txt

#C# compiler and build artifacts
*_i.c *_p.c *_h.h *_i.h *.ilk *.meta *.obj *.idb *.iobj *.pch *.pdb *.ipdb *.pgc *.pgd *.rsp !Directory.Build.rsp *.sbr *.tlb *.tli *.tlh *.tmp *.tmp_proj *_wpftmp.csproj *.log *.tlog *.builds *.pidb *.svclog *.cachefile *.binlog MSBuild_Logs/

#NuGet
*.nupkg *.snupkg /[Pp]ackages/ !*/[Pp]ackages/build/ *.nuget.props *.nuget.targets

#Publishing
publish/ PublishScripts/ *.publish.xml *.azurePubxml *.pubxml *.publishproj *.publishsettings

#SQL Server and local databases
*.mdf *.ldf *.ndf *.dbmdl *.db *.sqlite *.sqlite3

#Node.js / React / Angular
node_modules/ **/node_modules/ .npm/ .nx/ .angular/cache/ .next/ dist/

#Keep wwwroot tracked.
#ReSharper
_ReSharper*/ *.[Rr]e[Ss]harper *.DotSettings.user

#TeamCity
_TeamCity*

#DotCover / AxoCover
.dotCover .axoCover/ !.axoCover/settings.json

#NCrunch
NCrunch* .NCrunch_* .crunch.local.xml nCrunchTemp_*

#MightyMoose
.mm. AutoTest.Net/

#Web workbench
.sass-cache/

#Other development tools
.history/ .vshistory/ **/.localhistory/ **/.mfractor/ **/.ionide/ **/.fake/ **/.paket/paket.exe paket-files/

#VS Code
.vscode/* !.vscode/settings.json !.vscode/tasks.json !.vscode/launch.json !.vscode/extensions.json !.vscode/*.code-snippets

#Python
**/pycache/ *.pyc

#Backup and generated files
_UpgradeReport_Files/ Backup*/ UpgradeLog*.XML UpgradeLog*.htm MigrationBackup/ Generated_Code/

#Windows temporary files
Thumbs.db Desktop.ini ~$* *~

#Other
*.cab *.msi *.msix *.msixbundle *.msm *.msp *.vsix .aws-sam .ntvs_analysis.dat *.nvuser healthchecksdb orleans.codegen.cs
